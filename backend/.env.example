# ========================================================
# EcoFone Backend Environment Configuration (.env)
# Native PostgreSQL, Authentication, Payment & Storage
# ========================================================

# Server Port
PORT=4012

# Native PostgreSQL Database Connection
# DATABASE_URL: Application pooled or direct connection string
DATABASE_URL="postgresql://ecofone_user:secure_password@localhost:5432/ecofone?schema=public&sslmode=prefer"

# DIRECT_URL: Direct database connection used by Prisma CLI migrations
DIRECT_URL="postgresql://ecofone_user:secure_password@localhost:5432/ecofone?schema=public&sslmode=prefer"

# Authentication & Admin
JWT_SECRET="replace_with_strong_random_secret_min_32_chars"
MASTER_ADMIN_PASSWORD="replace_with_strong_master_admin_password"

# Razorpay Payment Gateway
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Cloudflare R2 / AWS S3 Storage (S3-Compatible Object Store)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="ecofone-bucket"
R2_PUBLIC_DOMAIN="https://pub-yourdomain.r2.dev"
